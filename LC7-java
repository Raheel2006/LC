//was easy,only problem is 32 bit overflow and underflow conditions

class Solution {
    public int reverse(int x) {
        long rev = 0;                                            //take long rather than int to make it easier to check

        while(x!=0){
            int rem = x%10;
            rev = rev*10 + rem;
            x/=10;
        }

        if(rev>Integer.MAX_VALUE || rev < Integer.MIN_VALUE){    //check for over/underflow 
            return 0;
        }

        return (int)rev;
    }
}
