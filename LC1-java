//initial sol used brute force
class Solution {
    public int[] twoSum(int[] nums, int target) {
        int[] arr = new int[2];
        for(int i = 0;i<nums.length;i++){
            int x = nums[i]-target;
            for(int j = i+1;j<nums.length;j++){
                if(nums[j] == x){
                    arr[0] = i;
                    arr[1] = j;
                    return arr;
                }
            }
        }
        return arr;
    }
}

//proper solution uses hashmap and reduces TC from O(n^2) to O(n) 

import java.util.HashMap;

class Solution {
    public int[] twoSum(int[] nums, int target) {
        HashMap<Integer,Integer> hm = new HashMap<>();
        for(int i = 0;i<nums.length;i++){
            int complement = target - nums[i];
            if(hm.containsKey(complement)){                //if our hashmap has a key equal to compliment it means that we have already seen a value whose sum with our 
                return new int[] {hm.get(complement),i};   //current value(nums[i]) is equal to target
            }
            hm.put(nums[i],i);                             //if compliment is not in hm then we store the curr value in hashmap to remember we have already seen it
        }
        return new int[0];
    }
}
